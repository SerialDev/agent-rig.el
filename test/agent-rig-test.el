      (should-error (agent-rig--select) :type 'user-error))))

(ert-deftest agent-rig-handoff-is-editable-and-does-not-send ()
  (let* ((source '((session . "source") (pane . "%1") (team . "team") (seat . "source")
                  (provider . "codex") (directory . "/tmp/")))
         (target '((session . "target") (team . "team") (seat . "target")
                  (provider . "claude-code") (status . "running") (directory . "/tmp/")))
         composed)
    (cl-letf (((symbol-function 'agent-rig--select) (lambda () source))
              ((symbol-function 'agent-rig-tmux-sessions) (lambda () (list source target)))
              ((symbol-function 'agent-rig-tmux--run)
               (lambda (command &rest _)
                 (should (equal command "capture-pane")) "captured result"))
              ((symbol-function 'completing-read) (lambda (_ choices &rest _) (cadr choices)))
              ((symbol-function 'agent-rig--compose)
               (lambda (targets text) (setq composed (list targets text)))))
      (agent-rig-handoff)
      (should (equal (car composed) (list target)))
      (should (string-match-p "captured result" (cadr composed)))
      (should (string-match-p "Objective:" (cadr composed))))))

(ert-deftest agent-rig-dashboard-navigation-keeps-actions-and-target-visible ()
  (let ((agent-rig-refresh-interval nil)
        (sessions '(((session . "one") (team . "team") (seat . "one")
                     (provider . "codex") (status . "running") (directory . "/tmp/"))
                    ((session . "two") (team . "team") (seat . "two")
                     (provider . "claude-code") (status . "running") (directory . "/tmp/")))))
    (with-temp-buffer
      (agent-rig-mode)
      (setq-local agent-rig--project-directory "/tmp/")
      (cl-letf (((symbol-function 'agent-rig-tmux-sessions) (lambda () sessions)))
        (agent-rig-refresh)
        (should hl-line-mode)
        (should (eq (key-binding (kbd "k")) #'agent-rig-previous-row))
        (should (eq (key-binding (kbd "x")) #'agent-rig-stop))
        (agent-rig-next-row)
        (should (equal (tabulated-list-get-id) "two"))
        (agent-rig-next-row)
        (should (equal (tabulated-list-get-id) "two"))
        (should (string-match-p "team/two" (buffer-string)))
        (should (text-property-any (point-min) (point-max) 'agent-rig-command #'agent-rig-send))
        (goto-char (point-max))
