                                      ((equal method "thread/read")
                                       `((thread . ((id . "root") (cwd . ,temporary-file-directory)
                                                    (status . ((type . "active") (activeFlags . ("waitingOnApproval"))))))))
                                      ((equal method "thread/list")
                                       (if (alist-get 'cursor params)
                                           '((data . (((id . "child") (parentThreadId . "root")
                                                       (agentNickname . "Worker") (status . ((type . "active")))))))
                                         '((data . (((id . "old") (parentThreadId . "root") (status . ((type . "notLoaded"))))))
                                           (nextCursor . "page-two"))))
                                      ((equal method "thread/items/list")
                                       '((data . (((item . ((type . "commandExecution") (command . "make check") (status . "inProgress")))))))))))
                          (lambda () (setq cancelled t))))))
      (agent-rig-codex-snapshot "root" temporary-file-directory
                                (lambda (error result) (should-not error) (setq observed result))))
    (should cancelled)
