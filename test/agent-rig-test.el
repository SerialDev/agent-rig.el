(defun agent-rig-test-opencode-http (status-json)
  (let ((process-environment (copy-sequence process-environment)) queue commands inputs result)
    (setenv "OPENCODE_SERVER_PASSWORD" "fixture-secret")
    (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
              ((symbol-function 'process-live-p) (lambda (_) nil))
              ((symbol-function 'process-status) (lambda (_) 'exit))
              ((symbol-function 'process-exit-status) (lambda (_) 0))
              ((symbol-function 'process-send-string) (lambda (_ text) (push text inputs)))
              ((symbol-function 'process-send-eof) #'ignore)
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (let* ((command (plist-get args :command))
                        (url (car (last command)))
                        (reply (cond
                                ((equal (car command) "lsof") "p42\nn127.0.0.1:4096\n")
                                ((string-match-p "/global/health?" url) "{\"healthy\":true,\"version\":\"fixture\"}")
                                ((string-match-p "/session/status?" url) status-json)
                                ((string-match-p "/children?" url) "[]")
                                ((string-match-p "/message?" url) "[{\"parts\":[{\"type\":\"tool\",\"tool\":\"bash\",\"state\":{\"status\":\"running\",\"title\":\"make check\"}}]}]")
                                (t (json-encode `((id . "root") (directory . ,temporary-file-directory)))))))
                   (push command commands)
                   (with-current-buffer (plist-get args :buffer) (insert reply))
                   (setq queue (append queue (list (plist-get args :sentinel))))
                   'fixture))))
      (agent-rig-opencode-snapshot `((status . "running") (pid . "42") (conversation . "root") (directory . ,temporary-file-directory))
                                  (lambda (error value) (setq result (list error value))))
      (while queue (funcall (pop queue) 'fixture "finished")))
    (list result commands inputs)))

(ert-deftest agent-rig-opencode-http-reads-bound-session-with-private-auth ()
  (pcase-let* ((`(,result ,commands ,inputs) (agent-rig-test-opencode-http "{\"root\":{\"type\":\"busy\"}}"))
               (snapshot (cadr result)))
    (should-not (car result))
    (should (equal (alist-get 'native snapshot) "busy"))
    (should (equal (alist-get 'subagents snapshot) "No direct child sessions."))
    (should (string-match-p "bash.*running.*make check" (alist-get 'tools snapshot)))
    (should (= (length commands) 6))
    (should (cl-some (lambda (command) (string-match-p "limit=10" (car (last command)))) commands))
    (should (cl-every (lambda (command) (not (member "fixture-secret" command))) commands))
    (should (cl-every (lambda (input) (string-prefix-p "header = \"Authorization: Basic " input)) inputs))))

